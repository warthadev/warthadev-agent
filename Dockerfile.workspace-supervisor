# Build separately from the ordinary agent runtime.
# Deploy only on the private Docker network, without published host ports.
# Required private-supervisor mounts (the two data views must be the same host directory):
#   /home/ubuntu/warthadev-datauser:/data/users:rw
#   /:/host:rw
#   /var/run/docker.sock:/var/run/docker.sock:rw
# The supervisor API uses /data/users. It creates/verifies task workspaces via
# /host/home/ubuntu/warthadev-datauser; Docker receives the host-daemon source
# /home/ubuntu/warthadev-datauser/<uid>/workspace. Keep the host-root bind and
# Docker socket private to this supervisor only.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WORKSPACE_DATA_ROOT=/data/users \
    WORKSPACE_HOST_ROOT=/host \
    WORKSPACE_HOST_DATA_ROOT=/host/home/ubuntu/warthadev-datauser \
    WORKSPACE_DOCKER_HOST_DATA_ROOT=/home/ubuntu/warthadev-datauser \
    PORT=8790

WORKDIR /app
RUN pip install --no-cache-dir "fastapi>=0.115,<1" "httpx>=0.27,<1" "pydantic>=2.9,<3" "uvicorn[standard]>=0.30,<1" "docker>=7,<8"
COPY workspace_supervisor.py ./

# EXPOSE documents the private listener; it does not publish a host port.
EXPOSE 8790
CMD ["uvicorn", "workspace_supervisor:app", "--host", "0.0.0.0", "--port", "8790", "--no-access-log"]
